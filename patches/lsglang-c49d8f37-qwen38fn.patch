+        for i in range(num_experts):
+            qweight = weight[i].view(torch.int32).T.contiguous()
+            tiled = gptq_marlin_repack(
+                b_q_weight=qweight, perm=perm, size_k=size_k, size_n=size_n, num_bits=4
+            )
+            flat[i].copy_(tiled.reshape(-1))
