diff -ruN base/python/sglang/srt/models/ple_nvme.py final/python/sglang/srt/models/ple_nvme.py
--- a/python/sglang/srt/models/ple_nvme.py	1970-01-01 08:00:00.000000000 +0800
+++ b/python/sglang/srt/models/ple_nvme.py	2026-09-11 22:05:05.000000000 +0800
@@ -0,0 +1,318 @@
+"""NVMe-backed storage for the Qwen3.8-Flash-Next PLE n-gram table
+(CUDA-graph-safe).
+
+The 47.7 GiB PLE table stays on NVMe. Row fetches run inside a CUDA host
+callback (``cudaLaunchHostFunc``), so the gather is capturable: the graph holds
+the D2H id copy, the host node and the H2D row copy, and replays them in
+order. The callback itself never calls a CUDA API.
+
+Buffers are allocated lazily on first use (always an eager forward, before
+graph capture) and sized to ``SGLANG_PLE_NVME_STAGING_TOKENS`` (default
+16384), so capture never allocates host memory. Buffers are keyed by
+(device, stream) so concurrent gathers on different streams cannot alias.
+
+Enabled with ``SGLANG_PLE_NVME=1``; manifest and cache size come from
+``SGLANG_PLE_NVME_MANIFEST`` and ``SGLANG_PLE_NVME_CACHE_GIB``.
+"""
+
+from __future__ import annotations
+
+import ctypes as C
+import glob
+import logging
+import os
+from pathlib import Path
+from typing import Dict, Optional, Tuple
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+_P, _U = C.c_void_p, C.c_uint64
+
+_LIB_PATH = os.environ.get(
+    "SGLANG_PLE_NVME_LIB", "libple_row_store.so"
+)
+
+
+def ple_nvme_enabled() -> bool:
+    return os.environ.get("SGLANG_PLE_NVME", "0").strip() in ("1", "true", "True")
+
+
+def _cudart_candidates():
+    """Candidate libcudart paths, most-likely-matching-torch first.
+
+    The runtime MUST match the one PyTorch was built against (CUDA 13 here):
+    mixing a system CUDA 12 cudart with a CUDA 13 context corrupts state and
+    segfaults inside host callbacks.
+    """
+    torch_cuda = (torch.version.cuda or "").split(".")[0]
+    patterns = []
+    try:
+        root = Path(torch.__file__).resolve().parent.parent
+        if torch_cuda:
+            patterns.append(str(root / "nvidia" / f"cu{torch_cuda}" / "lib" / "libcudart.so*"))
+        patterns.append(str(root / "nvidia" / "*" / "lib" / "libcudart.so*"))
+    except Exception:
+        pass
+    try:
+        import nvidia.cuda_runtime as _ncr  # type: ignore
+
+        patterns.append(str(Path(_ncr.__file__).parent / "lib" / "libcudart.so*"))
+    except Exception:
+        pass
+    if torch_cuda:
+        patterns.append(f"/usr/local/cuda-{torch_cuda}*/targets/x86_64-linux/lib/libcudart.so*")
+    patterns += [
+        "/usr/local/cuda*/targets/x86_64-linux/lib/libcudart.so*",
+        "/usr/lib/x86_64-linux-gnu/libcudart.so*",
+    ]
+    return patterns
+
+
+def _runtime_version(path: str):
+    """(major, minor) of the CUDA runtime this library provides, or None."""
+    try:
+        lib = C.CDLL(path)
+        v = C.c_int()
+        if lib.cudaRuntimeGetVersion(C.byref(v)) == 0 and v.value:
+            return (v.value // 1000, (v.value % 1000) // 10)
+    except Exception:
+        pass
+    return None
+
+
+def _find_cudart() -> str:
+    wanted = (torch.version.cuda or "").split(".")
+    want_major = int(wanted[0]) if wanted and wanted[0].isdigit() else None
+    fallback = None
+    for pattern in _cudart_candidates():
+        for path in sorted(glob.glob(pattern)):
+            if fallback is None:
+                fallback = path
+            got = _runtime_version(path)
+            if want_major is not None and got is not None and got[0] == want_major:
+                return path
+    if fallback is not None:
+        logger.warning(
+            "no libcudart matching torch CUDA %s found; using %s", torch.version.cuda, fallback
+        )
+        return fallback
+    raise OSError("libcudart.so not found")
+
+
+class _Work(C.Structure):
+    _fields_ = [
+        ("store", _P),
+        ("ids", _P),
+        ("weights", _P),
+        ("scales", _P),
+        ("count", _U),
+    ]
+
+
+class PleRowStore:
+    """Row reader for one PLE table backed by the checkpoint shards."""
+
+    def __init__(self, row_bytes: int = 160, cache_gib: Optional[float] = None):
+        manifest = os.environ.get("SGLANG_PLE_NVME_MANIFEST", "")
+        if not manifest or not os.path.exists(manifest):
+            raise RuntimeError(
+                f"SGLANG_PLE_NVME_MANIFEST missing or not found: {manifest!r}"
+            )
+        if cache_gib is None:
+            cache_gib = float(os.environ.get("SGLANG_PLE_NVME_CACHE_GIB", "2"))
+        lib = C.CDLL(_LIB_PATH)
+        lib.ple_store_open.argtypes = [C.c_char_p, _U, _U]
+        lib.ple_store_open.restype = _P
+        lib.ple_store_lookup_rows.argtypes = [
+            _P,
+            C.POINTER(C.c_int64),
+            C.POINTER(C.c_uint8),
+            _U,
+        ]
+        lib.ple_store_stats.argtypes = [_P, C.POINTER(C.c_uint64)]
+        lib.ple_store_close.argtypes = [_P]
+        self._lib = lib
+        self.row_bytes = row_bytes
+        self._store = lib.ple_store_open(
+            manifest.encode(), row_bytes, int(cache_gib * 2**30)
+        )
+        if not self._store:
+            raise RuntimeError(f"ple_store_open failed for {manifest}")
+        self._callback = C.cast(lib.ple_store_callback, C.c_void_p)
+
+        cudart_path = _find_cudart()
+        cuda = C.CDLL(cudart_path)
+        cuda.cudaLaunchHostFunc.argtypes = [_P, C.c_void_p, _P]
+        cuda.cudaLaunchHostFunc.restype = C.c_int
+        self._cuda = cuda
+        logger.info(
+            "PLE NVMe cudart: %s (torch CUDA %s, runtime %s)",
+            cudart_path,
+            torch.version.cuda,
+            _runtime_version(cudart_path),
+        )
+
+        self.capacity = int(
+            os.environ.get("SGLANG_PLE_NVME_STAGING_TOKENS", "16384")
+        )
+        self._stats_thread = None
+        if os.environ.get("SGLANG_PLE_NVME_STATS", "0").strip() in ("1", "true"):
+            import threading
+
+            def _report():
+                import time as _t
+
+                while True:
+                    _t.sleep(5)
+                    h, m, r, c = self.stats()
+                    raw, pr, mr = self.stats_merge()
+                    print(
+                        f"[ple-nvme] hits={h} misses={m} reads={r} cache={c} "
+                        f"raw_misses={raw} page_reads={pr} merge_ratio={mr:.1f}%",
+                        file=__import__("sys").stderr,
+                        flush=True,
+                    )
+
+            self._stats_thread = threading.Thread(target=_report, daemon=True)
+            self._stats_thread.start()
+        self._buffers: Dict[Tuple[int, int], dict] = {}
+        self._works: Dict[Tuple[int, int, int], _Work] = {}
+        # Capture-safe buffers: allocated now (eager, at model init) so graph
+        # capture never allocates host pinned memory, which CUDA forbids.
+        self._device_index = torch.cuda.current_device()
+        self._capture_buffers = self._make_buffers(self._device_index)
+        logger.info(
+            "PLE NVMe row store ready (cache %.1f GiB, staging %d tokens)",
+            cache_gib,
+            self.capacity,
+        )
+
+    def _make_buffers(self, device_index: int) -> dict:
+        device = torch.device("cuda", device_index)
+        n, row = self.capacity, self.row_bytes
+        # Explicit CPU device: model construction may run under a CUDA default
+        # device context, where pin_memory=True on torch.empty() would be
+        # rejected ("Only dense CPU tensors can be pinned").
+        return {
+            "ids_pinned": torch.empty(n, dtype=torch.int64, device="cpu").pin_memory(),
+            "rows_pinned": torch.empty(
+                n * row, dtype=torch.uint8, device="cpu"
+            ).pin_memory(),
+            "ids_gpu": torch.empty(n, dtype=torch.int64, device=device),
+            "rows_gpu": torch.empty(n, row, dtype=torch.uint8, device=device),
+            "seq": torch.arange(n, dtype=torch.int64, device=device),
+        }
+
+    def _grow_capacity(self, needed: int) -> None:
+        """Reallocate every stream's buffers at a larger capacity.
+
+        Old pinned buffers are dropped (the caching allocator frees them once
+        the last in-flight lookup finishes; lookups are stream-ordered so no
+        pending host func can still hold the old pointers afterwards). Works
+        entries are keyed by buffer address, so stale entries are simply never
+        hit again.
+        """
+        self.capacity = max(needed, self.capacity * 2)
+        logger.info(
+            "PLE NVMe staging grown to %d tokens (%.1f GiB pinned)",
+            self.capacity,
+            self.capacity * self.row_bytes * 9 / 2**30,
+        )
+        self._buffers.clear()
+
+    # -- buffers -----------------------------------------------------------
+
+    def _buffers_for(self, device_index: int, stream: int) -> dict:
+        key = (device_index, stream)
+        bufs = self._buffers.get(key)
+        if bufs is None:
+            bufs = self._make_buffers(device_index)
+            self._buffers[key] = bufs
+        return bufs
+
+    def _work_for(
+        self, stream_key: Tuple[int, int], count: int, ids_ptr: int, rows_ptr: int
+    ) -> _Work:
+        # The key must include the pinned-buffer addresses: graph capture runs
+        # its warmup and the capture itself on the SAME stream, first against
+        # the per-stream buffers and then against the capture buffers. Keying
+        # only by (device, stream, count) made the captured host node point at
+        # the warmup buffers while the captured D2H/H2D copies used the capture
+        # buffers, so every replay read stale warmup ids and produced garbage
+        # rows.
+        wkey = (stream_key[0], stream_key[1], count, ids_ptr, rows_ptr)
+        work = self._works.get(wkey)
+        if work is None:
+            work = _Work(self._store, ids_ptr, rows_ptr, 0, count)
+            self._works[wkey] = work
+        return work
+
+    # -- lookup ------------------------------------------------------------
+
+    def lookup(self, ids: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
+        """Graph-safe row fetch. `ids` may be a CUDA int64 tensor; returns
+        (rows_gpu [n, row_bytes] uint8, sequential ids [n]) in the same stream
+        order."""
+        flat = ids.reshape(-1)
+        n = flat.numel()
+        device_index = flat.device.index or 0
+        if n == 0:
+            device = torch.device("cuda", device_index)
+            return (
+                torch.empty(0, self.row_bytes, dtype=torch.uint8, device=device),
+                torch.empty(0, dtype=torch.int64, device=device),
+            )
+        if n > self.capacity:
+            # Chunked prefill can produce PLE lookups far larger than the
+            # staging capacity (e.g. 16k-token chunks with 4-gram ids expand to
+            # 4x rows). Grow the pinned staging buffers on demand instead of
+            # crashing; this runs eagerly (never during graph capture, which
+            # caps lookups at the captured token count).
+            self._grow_capacity(n)
+        stream = torch.cuda.current_stream(device_index).cuda_stream
+        if torch.cuda.is_current_stream_capturing():
+            bufs = self._capture_buffers
+        else:
+            bufs = self._buffers_for(device_index, stream)
+
+        bufs["ids_pinned"][:n].copy_(flat, non_blocking=True)
+        work = self._work_for(
+            (device_index, stream),
+            n,
+            bufs["ids_pinned"].data_ptr(),
+            bufs["rows_pinned"].data_ptr(),
+        )
+        err = self._cuda.cudaLaunchHostFunc(
+            C.c_void_p(stream), self._callback, C.cast(C.addressof(work), _P)
+        )
+        if int(err) != 0:
+            raise RuntimeError(f"cudaLaunchHostFunc failed: {err}")
+        bufs["rows_gpu"][:n].copy_(
+            bufs["rows_pinned"][: n * self.row_bytes].view(n, self.row_bytes),
+            non_blocking=True,
+        )
+        return bufs["rows_gpu"][:n], bufs["seq"][:n]
+
+    # -- introspection -----------------------------------------------------
+
+    def stats_merge(self) -> Tuple[int, int, float]:
+        """(raw_misses, page_reads, merge_ratio_pct) from ple_store_stats2."""
+        out = (C.c_uint64 * 16)()
+        try:
+            self._lib.ple_store_stats2(self._store, out)
+        except AttributeError:
+            return 0, 0, 0.0
+        raw, pr = out[12], out[13]
+        return raw, pr, ((raw - pr) * 100.0 / raw) if raw else 0.0
+
+    def stats(self) -> Tuple[int, int, int, int]:
+        out = (_U * 4)()
+        self._lib.ple_store_stats(self._store, out)
+        return out[0], out[1], out[2], out[3]
+
+    def close(self) -> None:
+        if getattr(self, "_store", None):
+            self._lib.ple_store_close(self._store)
+            self._store = None
